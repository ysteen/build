diff --git a/src/video_core/renderer_opengl/gl_webgl_stats.h b/src/video_core/renderer_opengl/gl_webgl_stats.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/renderer_opengl/gl_webgl_stats.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <array>
+#include <emscripten.h>
+
+namespace OpenGL {
+// Pass one pointer instead of 24 EM_ASM operands. Older Emscripten glue only declares $0..$15.
+inline void PublishWebGLStats(const std::array<double, 24>& data) {
+    EM_ASM({
+        const keys = ([
+            "fragmentLookups", "fragmentConfigMisses", "fragmentSourceMisses", "fragmentSourceHits",
+            "programLookups", "programMisses", "programCount", "preloadedShaders",
+            "preloadedPrograms", "preloadMs", "diskPrograms", "diskBytes", "persistWrites",
+            "parallelCompile", "genericInitMs", "genericPrograms", "genericDraws",
+            "asyncQueued", "asyncCompleted", "asyncFailed", "asyncPending", "asyncPeakPending",
+            "deferredDraws", "synchronousMisses"
+        ]);
+        const stats = {};
+        for (let i = 0; i < keys.length; ++i) stats[keys[i]] = HEAPF64[($0 >> 3) + i];
+        stats.parallelCompile = !!stats.parallelCompile;
+        globalThis.__AZAHAR_SHADER_CACHE__ = stats;
+    }, data.data());
+}
+} // namespace OpenGL

+                                                       const Profile& profile) {
+    using Stage = Pica::TexturingRegs::TevStageConfig;
+    using Texture = Pica::TexturingRegs::TextureConfig;
+    FSConfig config{input};
+    config.ApplyProfile(profile);
+    const u32 texture_type = static_cast<u32>(config.texture.texture0_type.Value());
+    const u32 fog = static_cast<u32>(config.texture.fog_mode.Value());
+    const auto logic = config.framebuffer.logic_op.Value();
+    if (profile.is_vulkan || !profile.has_minus_one_to_one_range || !user.IsCacheable() ||
+        config.lighting.enable || config.proctex.enable ||
+        config.framebuffer.shadow_rendering || config.EmulateBlend() ||
+        (texture_type != Texture::Texture2D && texture_type != Texture::Projection2D &&
+         texture_type != Texture::Disabled) || (fog != 0 && fog != 5) ||
+        (logic != FramebufferRegs::LogicOp::Copy && logic != FramebufferRegs::LogicOp::Clear &&
+         logic != FramebufferRegs::LogicOp::Set && logic != FramebufferRegs::LogicOp::NoOp)) {
+        return std::nullopt;
+    }
+    WebGLFSConfigData data;
+    data.texture = {texture_type, config.texture.texture2_use_coord1.Value(),
+                    config.texture.combiner_buffer_input.Value(), 0};
+    data.misc = {static_cast<u32>(config.framebuffer.depthmap_enable.Value()), fog,
+                 config.texture.fog_flip.Value(), static_cast<u32>(logic)};
+    data.control[3] = 6;
+    for (u32 i = 0; i < 3; ++i) {
+        data.texture[3] |= (config.texture.texture_border_color[i].raw & 3) << (i * 2);
+    }
+    for (u32 i = 0; i < 6; ++i) {
+        const Stage stage = config.texture.tev_stages[i];
+        const auto& raw = config.texture.tev_stages[i];
+        data.tev[i] = {raw.sources_raw, raw.modifiers_raw, raw.ops_raw, raw.scales_raw};
+        const u32 color_op = static_cast<u32>(stage.color_op.Value());
+        const u32 alpha_op = static_cast<u32>(stage.alpha_op.Value());
+        if (color_op > 9 || (color_op != 7 && (alpha_op > 9 || alpha_op == 6 || alpha_op == 7))) {
+            return std::nullopt;
+        }
+        const bool passthrough = color_op == 0 && alpha_op == 0 &&
+            stage.color_source1 == Stage::Source::Previous &&
+            stage.alpha_source1 == Stage::Source::Previous &&
+            stage.color_modifier1 == Stage::ColorModifier::SourceColor &&
+            stage.alpha_modifier1 == Stage::AlphaModifier::SourceAlpha &&
+            stage.GetColorMultiplier() == 1 && stage.GetAlphaMultiplier() == 1;
+        if (passthrough) continue;
+        data.control[0] |= 1U << i;
+        for (u32 channel = 0; channel < 2; ++channel) {
+            if (channel && color_op == 7) continue;
+            const u32 count = TevOperandCount(channel ? stage.alpha_op.Value() : stage.color_op.Value());
+            for (u32 operand = 0; operand < count; ++operand) {
+                const u32 shift = channel * 16 + operand * 4;
+                u32 source = (raw.sources_raw >> shift) & 15;
+                if (i == 0 && source == 15) {
+                    source = (raw.sources_raw >> (channel * 16 + 8)) & 15;
+                    data.tev[i][0] = (data.tev[i][0] & ~(15U << shift)) | (source << shift);
+                }
+                const u32 modifier = (raw.modifiers_raw >> (channel * 12 + operand * 4)) &
+                                     (channel ? 7 : 15);
+                if ((source > 6 && source < 13) ||
+                    (!channel && modifier > 5 && modifier != 8 && modifier != 9 &&
+                     modifier != 12 && modifier != 13)) {
+                    return std::nullopt;
+                }
+                if (source >= 3 && source <= 5) data.control[1] |= 1U << (source - 3);
+            }
+        }
+    }
+    return data;
+}
+
+std::string GenerateWebGLGenericFragmentShader() {
+    std::string source = R"(
+in vec4 primary_color;
+in vec2 texcoord0;
+in vec2 texcoord1;
+in vec2 texcoord2;
+in float texcoord0_w;
+layout(location = 0) out vec4 color;
+)";
+    source += GetFragmentUniformBlock();
+    source += R"(
+layout(std140) uniform pica_generic_config {
+    uvec4 pica_tev[6];
+    uvec4 pica_texture;
+    uvec4 pica_misc;
+    uvec4 pica_control;
+};
+uniform sampler2D tex0;
+uniform sampler2D tex1;
+uniform sampler2D tex2;
+uniform sampler2D texture_buffer_lut_lf;
+float byteround(float x) { return round(x * 255.0) * (1.0 / 255.0); }
+vec3 byteround(vec3 x) { return round(x * 255.0) * (1.0 / 255.0); }
+vec4 byteround(vec4 x) { return round(x * 255.0) * (1.0 / 255.0); }
+float getLod(vec2 coord) {
+    vec2 d = max(abs(dFdx(coord)), abs(dFdy(coord)));
+    return log2(max(d.x, d.y));
+}
+vec4 sampleGenericTexture(sampler2D tex, vec2 coord, int unit, bool projection) {
+    uint border = (pica_texture.w >> uint(unit * 2)) & 3u;
+    if (((border & 1u) != 0u && (coord.x < 0.0 || coord.x > 1.0)) ||
+        ((border & 2u) != 0u && (coord.y < 0.0 || coord.y > 1.0))) return tex_border_color[unit];
+    if (projection) return textureProj(tex, vec3(coord, texcoord0_w));
+    return textureLod(tex, coord, getLod(coord * vec2(textureSize(tex, 0))) + tex_lod_bias[unit]);
+}
+vec4 selectSource(uint selector, vec4 primary, vec4 previous, vec4 buffer_color,
+                  vec4 constant_color, vec4 t0, vec4 t1, vec4 t2) {
+    if (selector == 0u) return primary;
+    if (selector == 3u) return t0;
+    if (selector == 4u) return t1;
+    if (selector == 5u) return t2;
+    if (selector == 13u) return buffer_color;
+    if (selector == 14u) return constant_color;
+    if (selector == 15u) return previous;
+    return vec4(0.0);
+}
+vec3 modifyColor(vec4 value, uint modifier) {
+    vec3 result = value.rgb;
+    if (modifier / 2u == 1u) result = value.aaa;
+    if (modifier / 2u == 2u) result = value.rrr;
+    if (modifier / 2u == 4u) result = value.ggg;
+    if (modifier / 2u == 6u) result = value.bbb;
+    return (modifier & 1u) == 0u ? result : vec3(1.0) - result;
+}
+float modifyAlpha(vec4 value, uint modifier) {
+    float result = value.a;
+    if (modifier / 2u == 1u) result = value.r;
+    if (modifier / 2u == 2u) result = value.g;
+    if (modifier / 2u == 3u) result = value.b;
+    return (modifier & 1u) == 0u ? result : 1.0 - result;
+}
+vec3 combineColor(uint op, vec3 a, vec3 b, vec3 c) {
+    if (op == 0u) return a;
+    if (op == 1u) return a * b;
+    if (op == 2u) return a + b;
+    if (op == 3u) return a + b - vec3(0.5);
+    if (op == 4u) return mix(b, a, c);
+    if (op == 5u) return a - b;
+    if (op == 6u || op == 7u) return vec3(dot(a - vec3(0.5), b - vec3(0.5)) * 4.0);
+    if (op == 8u) return a * b + c;
+    return min(a + b, vec3(1.0)) * c;
+}
+float combineAlpha(uint op, float a, float b, float c) {
+    if (op == 0u) return a;
+    if (op == 1u) return a * b;
+    if (op == 2u) return a + b;
+    if (op == 3u) return a + b - 0.5;
+    if (op == 4u) return mix(b, a, c);
+    if (op == 5u) return a - b;
+    if (op == 8u) return a * b + c;
+    return min(a + b, 1.0) * c;
+}
+void main() {
+    if (alphatest_func == 0) discard;
+    if (scissor_mode != 0) {
+        bool inside_scissor = gl_FragCoord.x >= float(scissor_x1) &&
+            gl_FragCoord.y >= float(scissor_y1) && gl_FragCoord.x < float(scissor_x2) &&
+            gl_FragCoord.y < float(scissor_y2);
+        if (scissor_mode == 3 ? !inside_scissor : inside_scissor) discard;
+    }
+    float depth = (-2.0 * gl_FragCoord.z + 1.0) * depth_scale + depth_offset;
+    if (pica_misc.x == 0u) depth /= gl_FragCoord.w;
+    vec4 t0 = vec4(0.0), t1 = vec4(0.0), t2 = vec4(0.0);
+    if ((pica_control.y & 1u) != 0u && pica_texture.x != 5u)
+        t0 = sampleGenericTexture(tex0, texcoord0, 0, pica_texture.x == 3u);
+    if ((pica_control.y & 2u) != 0u) t1 = sampleGenericTexture(tex1, texcoord1, 1, false);
+    if ((pica_control.y & 4u) != 0u)
+        t2 = sampleGenericTexture(tex2, pica_texture.y != 0u ? texcoord1 : texcoord2, 2, false);
+    vec4 primary = byteround(primary_color);
+    vec4 previous = vec4(0.0), buffer_color = vec4(0.0);
+    vec4 next_buffer = tev_combiner_buffer_color;
+    // A uniform bound avoids six copies of the interpreter in the driver compiler.
+    for (uint stage = 0u; stage < pica_control.w; ++stage) {
+        uvec4 config = pica_tev[stage];
+        if ((pica_control.x & (1u << stage)) != 0u) {
+            vec3 rgb[3];
+            float alpha[3];
+            for (int operand = 0; operand < 3; ++operand) {
+                uint shift = uint(operand * 4);
+                rgb[operand] = modifyColor(selectSource((config.x >> shift) & 15u,
+                    primary, previous, buffer_color, const_color[stage], t0, t1, t2),
+                    (config.y >> shift) & 15u);
+                alpha[operand] = modifyAlpha(selectSource((config.x >> (16u + shift)) & 15u,
+                    primary, previous, buffer_color, const_color[stage], t0, t1, t2),
+                    (config.y >> (12u + shift)) & 7u);
+            }
+            uint color_op = config.z & 15u;
+            vec3 color_output = byteround(clamp(combineColor(color_op, rgb[0], rgb[1], rgb[2]), 0.0, 1.0));
+            float alpha_output = color_op == 7u ? color_output.r :
+                byteround(clamp(combineAlpha((config.z >> 16u) & 15u, alpha[0], alpha[1], alpha[2]), 0.0, 1.0));
+            uint color_scale = config.w & 3u, alpha_scale = (config.w >> 16u) & 3u;
+            previous = vec4(clamp(color_output * float(1u << (color_scale < 3u ? color_scale : 0u)), 0.0, 1.0),
+                clamp(alpha_output * float(1u << (alpha_scale < 3u ? alpha_scale : 0u)), 0.0, 1.0));
+        }
+        buffer_color = next_buffer;
+        if (stage < 4u) {
+            if ((pica_texture.z & (1u << stage)) != 0u) next_buffer.rgb = previous.rgb;
+            if ((pica_texture.z & (16u << stage)) != 0u) next_buffer.a = previous.a;
+        }
+    }
+    int alpha_value = int(previous.a * 255.0);
+    if ((alphatest_func == 2 && alpha_value != alphatest_ref) ||
+        (alphatest_func == 3 && alpha_value == alphatest_ref) ||
+        (alphatest_func == 4 && alpha_value >= alphatest_ref) ||
+        (alphatest_func == 5 && alpha_value > alphatest_ref) ||
+        (alphatest_func == 6 && alpha_value <= alphatest_ref) ||
+        (alphatest_func == 7 && alpha_value < alphatest_ref)) discard;
+    if (pica_misc.y == 5u) {
+        float fog_index = (pica_misc.z != 0u ? 1.0 - depth : depth) * 128.0;
+        float fog_i = clamp(floor(fog_index), 0.0, 127.0);
+        int index = int(fog_i) + fog_lut_offset;
+        vec2 entry = texelFetch(texture_buffer_lut_lf, ivec2(index & 2047, index >> 11), 0).rg;
+        float factor = clamp(entry.r + entry.g * (fog_index - fog_i), 0.0, 1.0);
+        previous.rgb = mix(fog_color, previous.rgb, factor);
+    }
+    gl_FragDepth = depth;
+    color = byteround(previous);
+    if (pica_misc.w == 0u) color = vec4(0.0);
+    if (pica_misc.w == 4u) color = vec4(1.0);
+}
+)";
+    return source;
+}
+} // namespace Pica::Shader::Generator::GLSL

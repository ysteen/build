+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+#pragma once
+
+#include <array>
+#include <cstring>
+#include <span>
+#include "video_core/pica/regs_pipeline.h"
+
+namespace OpenGL {
+
+// FLOAT4 inputs match ANGLE's initial vertex executable, avoiding draw-time type variants.
+inline bool ConvertWebGLVertexInput(std::span<const u8> source, u32 stride, u32 components,
+                                   Pica::PipelineRegs::VertexAttributeFormat format,
+                                   std::span<u8> destination) {
+    using Format = Pica::PipelineRegs::VertexAttributeFormat;
+    constexpr std::array<u32, 4> widths{1, 1, 2, 4};
+    const auto type = static_cast<u32>(format);
+    if (type >= widths.size() || components < 1 || components > 4 ||
+        destination.size() % 16 != 0) return false;
+    const auto count = destination.size() / 16;
+    const auto element_bytes = components * widths[type];
+    if (count && (stride == 0 || (count - 1) * u64{stride} + element_bytes > source.size()))
+        return false;
+    if (format == Format::FLOAT && components == 4 && stride == 16) {
+        if (count) std::memcpy(destination.data(), source.data(), destination.size());
+        return true;
+    }
+    for (std::size_t vertex = 0; vertex < count; ++vertex) {
+        const auto* input = source.data() + vertex * stride;
+        std::array<float, 4> output{0.f, 0.f, 0.f, 1.f};
+        if (format == Format::FLOAT) {
+            std::memcpy(output.data(), input, element_bytes);
+        } else {
+            for (u32 component = 0; component < components; ++component) {
+                switch (format) {
+                case Format::BYTE: {
+                    s8 value;
+                    std::memcpy(&value, input + component, sizeof(value));
+                    output[component] = value;
+                    break;
+                }
+                case Format::UBYTE:
+                    output[component] = input[component];
+                    break;
+                case Format::SHORT: {
+                    s16 value;
+                    std::memcpy(&value, input + component * 2, sizeof(value));
+                    output[component] = value;
+                    break;
+                }
+                default: return false;
+                }
+            }
+        }
+        std::memcpy(destination.data() + vertex * 16, output.data(), sizeof(output));
+    }
+    return true;
+}
+
+} // namespace OpenGL

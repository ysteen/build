+    };
+
+    bool Add(std::string_view vs, std::string_view fs) {
+        if (!ValidSource(vs) || !ValidSource(fs) || programs.size() >= MaxPrograms) {
+            return false;
+        }
+        const auto find = [&](u32 type, std::string_view source) {
+            for (u32 i = 0; i < shaders.size(); ++i) {
+                if (shaders[i].type == type && shaders[i].source == source) return i;
+            }
+            return static_cast<u32>(shaders.size());
+        };
+        u32 vi = find(0, vs), fi = find(1, fs);
+        const bool new_vs = vi == shaders.size(), new_fs = fi == shaders.size();
+        const std::size_t added = (new_vs ? vs.size() + 8 : 0) +
+                                  (new_fs ? fs.size() + 8 : 0) + 8;
+        if (shaders.size() + new_vs + new_fs > MaxShaders || bytes + added > MaxBytes) {
+            return false;
+        }
+        if (!new_vs && !new_fs &&
+            std::find(programs.begin(), programs.end(), Program{vi, fi}) != programs.end()) {
+            return false;
+        }
+        if (new_vs) {
+            vi = static_cast<u32>(shaders.size());
+            shaders.push_back({0, std::string(vs)});
+        }
+        if (new_fs) {
+            fi = static_cast<u32>(shaders.size());
+            shaders.push_back({1, std::string(fs)});
+        }
+        programs.push_back({vi, fi});
+        bytes += added;
+        return true;
+    }
+
+    std::string Encode(u64 key) const {
+        std::string out = "AZWGL001";
+        out.reserve(bytes);
+        Put(out, key, 8);
+        Put(out, shaders.size(), 4);
+        Put(out, programs.size(), 4);
+        for (const auto& shader : shaders) {
+            Put(out, shader.type, 4);
+            Put(out, shader.source.size(), 4);
+            out += shader.source;
+        }
+        for (const auto& program : programs) {
+            Put(out, program.vs, 4);
+            Put(out, program.fs, 4);
+        }
+        Put(out, Common::ComputeHash64(out.data(), out.size()), 8);
+        return out;
+    }
+
+    static std::optional<WebGLCacheData> Decode(std::string_view input, u64 key) {
+        if (input.size() < 32 || input.size() > MaxBytes || input.substr(0, 8) != "AZWGL001") {
+            return std::nullopt;
+        }
+        std::size_t pos = 8;
+        const auto get = [&](std::size_t count) -> u64 {
+            if (count > input.size() - pos) return 0;
+            u64 value = 0;
+            for (std::size_t i = 0; i < count; ++i) {
+                value |= u64(static_cast<unsigned char>(input[pos++])) << (8 * i);
+            }
+            return value;
+        };
+        if (get(8) != key) return std::nullopt;
+        const u64 shader_count = get(4), program_count = get(4);
+        if (shader_count > MaxShaders || program_count > MaxPrograms) return std::nullopt;
+        WebGLCacheData data;
+        for (u32 i = 0; i < shader_count; ++i) {
+            if (pos + 8 > input.size() - 8) return std::nullopt;
+            const u32 type = static_cast<u32>(get(4));
+            const u64 size = get(4);
+            if (type > 1 || size > MaxSourceBytes || size > input.size() - pos - 8) {
+                return std::nullopt;
+            }
+            const auto source = input.substr(pos, size);
+            if (!ValidSource(source)) return std::nullopt;
+            data.shaders.push_back({type, std::string(source)});
+            pos += size;
+        }
+        if (program_count * 8 + 8 != input.size() - pos) return std::nullopt;
+        for (u32 i = 0; i < program_count; ++i) {
+            Program program{static_cast<u32>(get(4)), static_cast<u32>(get(4))};
+            if (program.vs >= data.shaders.size() || program.fs >= data.shaders.size() ||
+                data.shaders[program.vs].type != 0 || data.shaders[program.fs].type != 1) {
+                return std::nullopt;
+            }
+            data.programs.push_back(program);
+        }
+        const auto expected = Common::ComputeHash64(input.data(), input.size() - 8);
+        if (get(8) != expected) return std::nullopt;
+        data.bytes = input.size();
+        return data;
+    }
+
+    std::vector<Shader> shaders;
+    std::vector<Program> programs;
+    std::size_t bytes = 32;
+
+private:
+    static bool ValidSource(std::string_view source) {
+        return !source.empty() && source.size() <= MaxSourceBytes &&
+               source.find('\0') == std::string_view::npos;
+    }
+    static void Put(std::string& out, u64 value, std::size_t count) {
+        for (std::size_t i = 0; i < count; ++i) {
+            out.push_back(static_cast<char>((value >> (8 * i)) & 255));
+        }
+    }
+};
+
+} // namespace OpenGL

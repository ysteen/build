+/* Preflight every RASTATE block before core_unserialize can mutate the core.
+ * The legacy parser otherwise reads block headers without bounds checks. */
+static bool ejs_validate_state_container(const unsigned char *data, size_t size)
+{
+   size_t offset = 8;
+   bool seen_core = false;
+   if (!data || size < 8)
+      return false;
+   if (memcmp(data, "RASTATE", 7) != 0)
+      return true; /* Raw core archives are validated by the core itself. */
+   if (data[7] != 1)
+      return false;
+   while (offset < size)
+   {
+      const unsigned char *marker;
+      size_t length, padded;
+      if (size - offset < 8)
+         return false;
+      marker = data + offset;
+      length = (uint32_t)marker[4] | ((uint32_t)marker[5] << 8) |
+               ((uint32_t)marker[6] << 16) | ((uint32_t)marker[7] << 24);
+      offset += 8;
+      if (length > size - offset || length > SIZE_MAX - 7)
+         return false;
+      padded = CONTENT_ALIGN_SIZE(length);
+      if (padded > size - offset)
+         return false;
+      if (memcmp(marker, RASTATE_END_BLOCK, 4) == 0)
+         return seen_core && length == 0 && offset == size;
+      if (memcmp(marker, RASTATE_MEM_BLOCK, 4) == 0)
+      {
+         if (seen_core || length == 0)
+            return false;
+         seen_core = true;
+      }
+      offset += padded;
+   }
+   return false;
+}

+/* Optional Azahar web API: cwrap("load_state_sync", "number", ["string"]).
+ * Returns 1 only after the core accepts the state, otherwise 0. This avoids
+ * the legacy load_state return value (which merely echoes its second arg)
+ * and its deferred task, so the frontend can display real load failures. */
+int load_state_sync(const char *path)
+{
+   const int64_t max_size = 512 * 1024 * 1024;
+   RFILE *file;
+   int64_t size;
+   unsigned char *data;
+   bool result = false;
+   if (!path || !core_info_current_supports_savestate())
+      return 0;
+#ifdef HAVE_CHEEVOS
+   if (rcheevos_hardcore_active())
+      return 0;
+#endif
+   file = filestream_open(path, RETRO_VFS_FILE_ACCESS_READ,
+                          RETRO_VFS_FILE_ACCESS_HINT_NONE);
+   if (!file)
+      return 0;
+   size = filestream_get_size(file);
+   if (size < 8 || size > max_size)
+   {
+      filestream_close(file);
+      return 0;
+   }
+   data = (unsigned char*)malloc((size_t)size);
+   if (data && filestream_read(file, data, size) == size &&
+       ejs_validate_state_container(data, (size_t)size))
+      result = content_deserialize_state(data, (size_t)size);
+   free(data);
+   filestream_close(file);
+   return result ? 1 : 0;
+}

@@ -0,0 +1,28 @@
+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+#pragma once
+
+// Named WebGL lookups avoid Emscripten's enumeration of every active uniform.
+EM_JS(void, BindWebGLProgramResources, (unsigned int program, unsigned int previous), {
+    const object = GL.programs[program];
+    const restore = GL.programs[previous] || null;
+    GLctx.useProgram(object);
+    try {
+        const samplers = ["tex0", "tex1", "tex2", "texture_buffer_lut_lf",
+                          "texture_buffer_lut_rg", "texture_buffer_lut_rgba",
+                          "tex_normal", "tex_color"];
+        for (let unit = 0; unit < samplers.length; ++unit) {
+            const location = GLctx.getUniformLocation(object, samplers[unit]);
+            if (location !== null) GLctx.uniform1i(location, unit);
+        }
+        const blocks = ["vs_pica_data", "vs_data", "fs_data", "pica_generic_config"];
+        for (let binding = 0; binding < blocks.length; ++binding) {
+            const index = GLctx.getUniformBlockIndex(object, blocks[binding]);
+            if (index !== 0xffffffff) GLctx.uniformBlockBinding(object, index, binding);
+        }
+    } finally {
+        // The Emscripten currentProgram cache stays equal to the restored state.
+        GLctx.useProgram(restore);
+    }
+});

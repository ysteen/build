+/* Emscripten's targetX/targetY are CSS-pixel coordinates relative to the
+ * canvas element. The canvas itself is object-fit: contain, so multiplying by
+ * DPR is not sufficient when the browser adds letterboxing or the page is
+ * zoomed. Convert through the displayed content rectangle and return the
+ * actual Wasm framebuffer coordinates. */
+EM_JS(void, rwebinput_map_canvas_point,
+      (double target_x, double target_y, int out_ptr), {
+   const canvas = document.getElementById("canvas") ||
+      (typeof Module !== "undefined" ? Module.canvas : null);
+   const out = out_ptr >> 2;
+   if (!canvas) {
+      HEAP32[out] = -32768;
+      HEAP32[out + 1] = -32768;
+      HEAP32[out + 2] = 1;
+      return;
+   }
+
+   const rect = canvas.getBoundingClientRect();
+   const dpr = globalThis.devicePixelRatio || 1;
+   const source_width = canvas.width || Math.max(1, Math.round(rect.width * dpr));
+   const source_height = canvas.height || Math.max(1, Math.round(rect.height * dpr));
+   const content_width = Math.min(rect.width, rect.height * source_width / source_height);
+   const content_height = content_width * source_height / source_width;
+   const content_left = (rect.width - content_width) / 2;
+   // EmulatorJS uses object-position: top for the canvas.
+   const content_top = 0;
+   const inside = target_x >= content_left && target_x < content_left + content_width &&
+      target_y >= content_top && target_y < content_top + content_height;
+
+   if (!inside || content_width <= 0 || content_height <= 0) {
+      HEAP32[out] = -32768;
+      HEAP32[out + 1] = -32768;
+      HEAP32[out + 2] = 1;
+      return;
+   }

+#if defined(__EMSCRIPTEN__)
+GLintptr OGLStreamBuffer::UploadCached(std::span<const u8> data, GLintptr alignment) {
+    const u64 hash = Common::ComputeHash64(data.data(), data.size());
+    auto& cached = cached_uploads[hash % cached_uploads.size()];
+    auto& stats = WebGLSubmission::counters[gl_target == GL_UNIFORM_BUFFER ? 1 :
+        gl_target == GL_ELEMENT_ARRAY_BUFFER ? 2 : 0];
+    if (!data.empty() && cached.size == data.size() && cached.hash == hash &&
+        (alignment == 0 || cached.offset % alignment == 0) &&
+        std::memcmp(shadow.data() + cached.offset, data.data(), data.size()) == 0) {
+        ++stats.hits;
+        stats.reused_bytes += data.size();
+        return cached.offset;
+    }
+    ++stats.misses;
+    const auto [destination, offset, invalidate] = Map(data.size(), alignment);
+    if (!data.empty()) std::memcpy(destination, data.data(), data.size());
+    Unmap(data.size());
+    cached = {hash, offset, data.size()};
+    return offset;
+}
+#endif
+
 } // namespace OpenGL

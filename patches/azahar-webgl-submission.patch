+#if defined(__EMSCRIPTEN__)
+void RasterizerOpenGL::UploadReusedUniforms(bool accelerate_draw) {
+    const bool sync_pica = accelerate_draw && pica.vs_setup.uniforms_dirty;
+    if (!sync_pica && !vs_data_dirty && !fs_data_dirty) return;
+    const auto upload = [&](unsigned binding, const auto& data) {
+        auto& buffer = reused_uniform_buffers[binding];
+        if (!buffer) buffer = std::make_unique<OGLStreamBuffer>(driver, GL_UNIFORM_BUFFER, 256_KiB);
+        const auto offset = buffer->UploadCached(
+            {reinterpret_cast<const u8*>(&data), sizeof(data)}, uniform_buffer_alignment);
+        if (reused_uniform_offsets[binding] != offset) {
+            glBindBufferRange(GL_UNIFORM_BUFFER, binding, buffer->GetHandle(), offset, sizeof(data));
+            reused_uniform_offsets[binding] = offset;
+        }
+    };
+    if (vs_data_dirty) {
+        upload(UniformBindings::VSData, vs_data);
+        vs_data_dirty = false;
+    }
+    if (fs_data_dirty) {
+        upload(UniformBindings::FSData, fs_data);
+        fs_data_dirty = false;
+    }
+    if (sync_pica) {
+        VSPicaUniformData data{};
+        data.SetFromRegs(pica.vs_setup);
+        upload(UniformBindings::VSPicaData, data);
+        pica.vs_setup.uniforms_dirty = false;
+    }
+    glBindBuffer(GL_UNIFORM_BUFFER, OpenGLState::GetCurState().draw.uniform_buffer);
+}
+#endif
+
 } // namespace OpenGL

+#ifndef NDSCART_SAVEAUTO_H
+#define NDSCART_SAVEAUTO_H
+
+#include "types.h"
+
+namespace NDSCart
+{
+
+// Unknown-game SPI heuristics infer address width, never exact physical capacity.
+// The caller retains input bytes and restarts safely when Changed becomes true.
+class SaveAutoDetector
+{
+public:
+    u32 AddressBytes = 2;
+    u32 CandidateBytes = 0;
+    u32 CandidateVotes = 0;
+    u32 Transactions = 0;
+    bool Confirmed = false;
+    bool Flash = false;
+    bool Changed = false;
+
+    void Initialize(const u8* data, u32 length, u32 learnedAddress = 0, bool learnedFlash = false)
+    {
+        AddressBytes = 2;
+        CandidateBytes = 0;
+        CandidateVotes = 0;
+        Transactions = 0;
+        Confirmed = false;
+        Flash = false;
+        Changed = false;
+
+        if (learnedAddress >= 1 && learnedAddress <= 3)
+        {
+            AddressBytes = CandidateBytes = learnedAddress;
+            CandidateVotes = 2;
+            Confirmed = true;
+            Flash = learnedAddress == 3 && learnedFlash;
+            return;
+        }
+
+        // A nonempty suffix gives only a tentative minimum; padding is not a chip type.
+        if (data)
+        {
+            while (length && data[length - 1] == 0xFF) length--;
+            if (length) AddressBytes = length <= 512 ? 1 : length <= 65536 ? 2 : 3;
+        }
+    }
+
+    void Observe(u8 command, u32 payloadLength)
+    {
+        if (Transactions != 0xFFFFFFFFu) Transactions++;
+
+        if ((command == 0xD8 || command == 0xDB) && payloadLength == 3)
+        {
+            if (!Confirmed || AddressBytes == 3)
+            {
+                Changed |= AddressBytes != 3;
+                AddressBytes = CandidateBytes = 3;
+                CandidateVotes = 2;
+                Confirmed = Flash = true;
+            }
+            return;
+        }
+        if (Confirmed) return;
+
+        const bool blockWrite = (command == 0x02 || command == 0x0A) && payloadLength > 4;
+        if (command != 0x03 && !blockWrite) return;
+
+        // Typical probes read one byte; block reads commonly request multiples of four.
+        // Arbitrary read lengths remain ambiguous; two agreeing probes reduce false matches.
+        u32 candidate = payloadLength >= 2 && payloadLength <= 4
+            ? payloadLength - 1 : payloadLength > 4 ? payloadLength & 3 : 0;
+        if (!candidate) return;
+
+        // A block write may support an earlier read, but never originate or change a guess.
+        if (blockWrite && (!CandidateVotes || CandidateBytes != candidate)) return;
+
+        if (CandidateBytes != candidate)
+        {
+            CandidateBytes = candidate;
+            CandidateVotes = 1;
+            return;
+        }
+        if (CandidateVotes < 2) CandidateVotes++;
+        if (CandidateVotes == 2)
+        {
+            Changed |= AddressBytes != candidate;
+            AddressBytes = candidate;
+            Confirmed = true;
+        }
+    }
+};
+
+}
+
+#endif

+bool CartRetail::ResizeAutoSave(u32 minimum)
+{
+    if (minimum <= SRAMLength) return true;
+    static const u32 sizes[] = {512, 8192, 65536, 131072, 262144, 524288, 1048576};
+    u32 length = 0;
+    for (u32 size : sizes)
+        if (size >= minimum) { length = size; break; }
+    if (!length) return false;
+    u8* buffer = new u8[length];
+    memset(buffer, 0xFF, length);
+    if (SRAMLength) memcpy(buffer, SRAM, SRAMLength);
+    delete[] SRAM;
+    SRAM = buffer;
+    SRAMLength = length;
+    NDSCart_SRAMManager::Rebind(SRAM, SRAMLength);
+    return true;
+}
+
+u8 CartRetail::SRAMWrite_Auto(u8 val, u32 pos, bool last)
+{
+    if (AutoSaveRestart) return 0xFF;
+    if (pos == 0)
+    {
+        SPIEndTransaction();
+        if (AutoSaveRestart) return 0xFF;
+        SRAMAutoPending = true;
+        SRAMAutoCommand = val;
+        SRAMAutoLength = 0;
+        SRAMCmd = val;
+        SRAMAddr = 0;
+        if (val == 0x04) SRAMStatus &= ~2;
+        if (val == 0x06) SRAMStatus |= 2;
+        if (last) SPIEndTransaction();
+        return 0;
+    }
+    SRAMAutoLength = pos;
+    const u32 addressBytes = SRAMDetector.AddressBytes;
+    const bool tiny = addressBytes == 1;
+    const u32 addressMask = tiny ? 0x1FF : (addressBytes == 2 ? 0xFFFF : 0xFFFFFF);
+    u8 result = 0;
+    switch (SRAMCmd)
+    {
+    case 0x01:
+        if (pos == 1) SRAMStatus = (SRAMStatus & 1) | (val & 0x0C);
+        break;
+    case 0x05:
+        result = SRAMStatus | (tiny ? 0xF0 : 0);
+        break;
+    case 0x9F:
+        result = 0xFF;
+        break;
+    case 0x02:
+    case 0x03:
+    case 0x0A:
+    case 0x0B:
+        if (pos <= addressBytes)
+        {
+            SRAMAddr = (SRAMAddr << 8) | val;
+            if (tiny && (SRAMCmd == 0x0A || SRAMCmd == 0x0B)) SRAMAddr |= 0x100;
+        }
+        else if (!(SRAMCmd == 0x0B && !tiny && pos == addressBytes + 1))
+        {
+            const u32 address = SRAMAddr & addressMask;
+            if (SRAMCmd == 0x03 || SRAMCmd == 0x0B)
+                result = address < SRAMLength ? SRAM[address] : 0xFF;
+            else if ((SRAMStatus & 2) && ResizeAutoSave(address + 1))
+            {
+                // Page program supports EEPROM until erase commands identify flash.
+                SRAM[address] = (SRAMCmd == 0x02 && SRAMDetector.Flash) ? 0 : val;
+                SRAMFileDirty = true;
+            }
+            SRAMAddr++;
+        }
+        if (last && (SRAMCmd == 0x02 || SRAMCmd == 0x0A)) SRAMStatus &= ~2;
+        break;
+    case 0xD8:
+    case 0xDB:
+        if (pos <= 3) SRAMAddr = (SRAMAddr << 8) | val;
+        if (pos == 3 && (SRAMStatus & 2))
+        {
+            const u32 length = SRAMCmd == 0xD8 ? 0x10000 : 0x100;
+            const u32 address = SRAMAddr & ~(length - 1);
+            if (ResizeAutoSave(address + length))
+            {
+                memset(SRAM + address, 0, length);
+                SRAMFileDirty = true;
+            }
+        }
+        if (last) SRAMStatus &= ~2;
+        break;
+    default:
+        break;
+    }
+    if (last) SPIEndTransaction();
+    return result;
+}

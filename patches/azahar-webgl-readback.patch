diff --git a/src/video_core/host_shaders/webgl_readback_depth.frag b/src/video_core/host_shaders/webgl_readback_depth.frag
new file mode 100644
index 0000000..269b1aa
--- /dev/null
+++ b/src/video_core/host_shaders/webgl_readback_depth.frag
@@ -0,0 +1,18 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version.
+
+uniform highp sampler2D source_depth;
+uniform int source_level;
+uniform float depth_scale;
+out vec4 result;
+
+void main() {
+    float depth = texelFetch(source_depth, ivec2(gl_FragCoord.xy), source_level).r;
+    // Some depth samplers land exactly half a unit below a 24-bit integer.
+    // GLSL round() may choose the even/lower value at ties. Add the correction
+    // as an integer so float + 0.5 cannot round large odd integers up again.
+    float scaled_depth = depth * depth_scale;
+    uint packed_depth = uint(scaled_depth) + uint(fract(scaled_depth) >= 0.5);
+    result = vec4(float(packed_depth & 255u), float((packed_depth >> 8u) & 255u),
+                  float((packed_depth >> 16u) & 255u), 0.0) / 255.0;
+}

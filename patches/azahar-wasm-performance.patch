diff --git a/src/video_core/pica/vertex_cache.h b/src/video_core/pica/vertex_cache.h
new file mode 100644
index 0000000..c798335
--- /dev/null
+++ b/src/video_core/pica/vertex_cache.h
@@ -0,0 +1,56 @@
+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace Pica {
+
+// A lookup hint accelerates hits without changing the fully associative FIFO replacement
+// policy. Collisions and stale hints fall back to the original search over resident vertices.
+class VertexCacheIndex {
+public:
+    static constexpr unsigned Capacity = 64;
+    static constexpr unsigned Missing = Capacity;
+
+    unsigned Find(std::uint16_t vertex) {
+        const unsigned hash = Hash(vertex);
+        const unsigned hint = hints[hash];
+        if (hint < count && vertices[hint] == vertex) {
+            return hint;
+        }
+        for (unsigned i = 0; i < count; ++i) {
+            if (vertices[i] == vertex) {
+                hints[hash] = static_cast<std::uint8_t>(i);
+                return i;
+            }
+        }
+        return Missing;
+    }
+
+    unsigned Insert(std::uint16_t vertex) {
+        const unsigned slot = next;
+        vertices[slot] = vertex;
+        hints[Hash(vertex)] = static_cast<std::uint8_t>(slot);
+        next = (next + 1) % Capacity;
+        if (count < Capacity) {
+            ++count;
+        }
+        return slot;
+    }
+
+private:
+    static constexpr unsigned Hash(std::uint16_t vertex) {
+        return (vertex ^ (vertex >> 8)) & 0xff;
+    }
+
+    std::array<std::uint16_t, Capacity> vertices;
+    std::array<std::uint8_t, 256> hints{};
+    unsigned next = 0;
+    unsigned count = 0;
+};
+
+} // namespace Pica
diff --git a/src/video_core/shader/shader_stack.h b/src/video_core/shader/shader_stack.h
new file mode 100644
index 0000000..bec104a
--- /dev/null
+++ b/src/video_core/shader/shader_stack.h
@@ -0,0 +1,52 @@
+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <type_traits>
+
+namespace Pica::Shader {
+
+// Preserve the interpreter's overwrite-oldest behavior on overflow. Inline storage avoids
+// allocating three circular buffers for every vertex processed by the interpreter.
+template <typename T, std::size_t Capacity>
+class ShaderStack {
+    static_assert(Capacity > 0 && (Capacity & (Capacity - 1)) == 0);
+    static_assert(std::is_trivial_v<T>);
+
+public:
+    void push_back(const T& value) {
+        entries[next] = value;
+        next = (next + 1) & (Capacity - 1);
+        if (count < Capacity) {
+            ++count;
+        }
+    }
+
+    void pop_back() {
+        next = (next + Capacity - 1) & (Capacity - 1);
+        --count;
+    }
+
+    T& back() {
+        return entries[(next + Capacity - 1) & (Capacity - 1)];
+    }
+
+    bool empty() const {
+        return count == 0;
+    }
+
+    std::size_t size() const {
+        return count;
+    }
+
+private:
+    std::array<T, Capacity> entries;
+    std::size_t next = 0;
+    std::size_t count = 0;
+};
+
+} // namespace Pica::Shader
diff --git a/src/video_core/shader/shader_interpreter_decoded.h b/src/video_core/shader/shader_interpreter_decoded.h
new file mode 100644
index 0000000..9ab4532
--- /dev/null
+++ b/src/video_core/shader/shader_interpreter_decoded.h
@@ -0,0 +1,139 @@
+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <nihstro/shader_bytecode.h>
+#include "common/common_types.h"
+#include "video_core/pica/shader_setup.h"
+#include "video_core/pica/shader_unit.h"
+
+namespace Pica::Shader {
+
+// Cache instruction decoding, never uniform values or per-vertex register contents.
+struct DecodedSource {
+    u16 offset;
+    u8 address_register;
+    bool uniform;
+    std::array<u8, 4> selectors;
+    bool negate;
+    bool identity;
+    bool broadcast;
+};
+
+struct DecodedInstruction {
+    u64 version = 0;
+    nihstro::Instruction instruction;
+    nihstro::SwizzlePattern swizzle;
+    nihstro::OpCode::Type type;
+    nihstro::OpCode::Id opcode;
+    std::array<DecodedSource, 3> sources;
+    u16 destination;
+    bool has_src2;
+};
+
+struct DecodedProgram {
+    std::array<DecodedInstruction, MAX_PROGRAM_CODE_LENGTH> instructions;
+};
+
+inline DecodedSource DecodeSource(nihstro::SourceRegister source, u32 address_register,
+                                 const nihstro::SwizzlePattern& swizzle, unsigned operand) {
+    const bool uniform = source.GetRegisterType() == nihstro::RegisterType::FloatUniform;
+    const auto offset = uniform ? Uniforms::GetFloatUniformOffset(source.GetIndex())
+                        : source.GetRegisterType() == nihstro::RegisterType::Input
+                            ? ShaderUnit::InputOffset(source.GetIndex())
+                            : ShaderUnit::TemporaryOffset(source.GetIndex());
+    DecodedSource result{};
+    result.offset = static_cast<u16>(offset);
+    result.uniform = uniform;
+    result.address_register = uniform ? static_cast<u8>(address_register) : 0;
+    const unsigned selector = swizzle.GetRawSelector(operand);
+    for (unsigned i = 0; i < 4; ++i) {
+        result.selectors[i] = (selector >> (6 - i * 2)) & 3;
+    }
+    result.negate = operand == 1 ? swizzle.negate_src1.Value()
+                    : operand == 2 ? swizzle.negate_src2.Value()
+                                   : swizzle.negate_src3.Value();
+    result.identity = selector == 0x1b;
+    result.broadcast = (selector & 0x3f) == ((selector >> 2) & 0x3f);
+    return result;
+}
+
+inline void DecodeInstruction(DecodedInstruction& decoded, const ShaderSetup& setup, u32 pc) {
+    using OpCode = nihstro::OpCode;
+    nihstro::Instruction instr{};
+    // Match the original interpreter's malformed-shader guard, including an entry beyond the end.
+    if (pc < MAX_PROGRAM_CODE_LENGTH - 1) {
+        instr.hex = setup.GetProgramCode()[pc];
+    } else {
+        instr.opcode.Assign(OpCode::Id::END);
+    }
+    decoded.instruction = instr;
+    decoded.type = instr.opcode.Value().GetInfo().type;
+    decoded.opcode = instr.opcode.Value().EffectiveOpCode();
+    const bool mad = decoded.type == OpCode::Type::MultiplyAdd;
+    decoded.swizzle.hex = setup.GetSwizzleData()[mad ? instr.mad.operand_desc_id.Value()
+                                                   : instr.common.operand_desc_id.Value()];
+    if (decoded.type == OpCode::Type::Arithmetic || mad) {
+        decoded.has_src2 = mad || (instr.opcode.Value().GetInfo().subtype & OpCode::Info::Src2);
+        const bool inverted = instr.opcode.Value().GetInfo().subtype & OpCode::Info::SrcInversed;
+        const auto& swizzle = decoded.swizzle;
+        const u32 address_register = mad ? instr.mad.address_register_index.Value()
+                                        : instr.common.address_register_index.Value();
+        decoded.sources[0] =
+            DecodeSource(mad ? instr.mad.GetSrc1(inverted) : instr.common.GetSrc1(inverted),
+                         !mad && !inverted ? address_register : 0, swizzle, 1);
+        decoded.sources[1] =
+            DecodeSource(mad ? instr.mad.GetSrc2(inverted) : instr.common.GetSrc2(inverted),
+                         mad != inverted ? address_register : 0, swizzle, 2);
+        if (mad) {
+            decoded.sources[2] = DecodeSource(instr.mad.GetSrc3(inverted),
+                                             inverted ? address_register : 0, swizzle, 3);
+        }
+        const auto dest = mad ? instr.mad.dest.Value() : instr.common.dest.Value();
+        decoded.destination =
+            static_cast<u16>(dest < 0x10 ? ShaderUnit::OutputOffset(dest.GetIndex())
+                                        : ShaderUnit::TemporaryOffset(dest.GetIndex()));
+    }
+    decoded.version = setup.interpreter_cache.version;
+}
+
+inline void LoadDecodedSource(const ShaderSetup& setup, const ShaderUnit& state,
+                              const DecodedSource& source, f24 (&result)[4]) {
+    static constexpr std::array<f24, 4> ones{f24::One(), f24::One(), f24::One(), f24::One()};
+    // A direct uniform register is always in range. Resolve both ordinary register banks with
+    // a byte offset; only relative uniforms need wrapping and the hardware's out-of-range ones.
+    const auto* base = source.uniform ? reinterpret_cast<const u8*>(&setup.uniforms)
+                                      : reinterpret_cast<const u8*>(&state);
+    const f24* values = reinterpret_cast<const f24*>(base + source.offset);
+    if (source.address_register) {
+        unsigned index = source.offset / sizeof(Common::Vec4<f24>);
+        int offset = state.address_registers[source.address_register - 1];
+        if (offset < -128 || offset > 127) {
+            offset = 0;
+        }
+        index = (index + offset) & 0x7f;
+        values = index < 96 ? &setup.uniforms.f[index].x : ones.data();
+    }
+    if (source.identity) {
+        for (unsigned i = 0; i < 4; ++i) {
+            result[i] = source.negate ? -values[i] : values[i];
+        }
+    } else if (source.broadcast) {
+        const f24 value = source.negate ? -values[source.selectors[0]]
+                                        : values[source.selectors[0]];
+        std::fill(std::begin(result), std::end(result), value);
+    } else {
+        for (unsigned i = 0; i < 4; ++i) {
+            result[i] = values[source.selectors[i]];
+            if (source.negate) {
+                result[i] = -result[i];
+            }
+        }
+    }
+}
+
+} // namespace Pica::Shader

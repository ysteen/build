diff --git a/src/core/arm/skyeye_common/armstate.h b/src/core/arm/skyeye_common/armstate.h
index f36c46c..7523369 100644
--- a/src/core/arm/skyeye_common/armstate.h
+++ b/src/core/arm/skyeye_common/armstate.h
@@ -256,6 +256,58 @@ public:
     // process for our purposes), not per ARMul_State (which tracks CPU core state).
     std::unordered_map<u32, std::size_t> instruction_cache;
 
+#ifdef __EMSCRIPTEN__
+    bool enable_wasm_fast_paths = true;
+
+    // DynCom dispatches at every translated basic-block boundary. Keep a small direct-mapped
+    // cache in front of unordered_map so hot branches stay on a compact WebAssembly fast path.
+    static constexpr std::size_t FAST_INSTRUCTION_CACHE_BITS = 12;
+    static constexpr std::size_t FAST_INSTRUCTION_CACHE_SIZE =
+        1U << FAST_INSTRUCTION_CACHE_BITS;
+
+    struct FastInstructionCacheEntry {
+        std::size_t offset = 0;
+        u32 pc = 0;
+        u32 generation = 0;
+    };
+
+    bool LookupFastInstructionCache(u32 pc, std::size_t& offset) const {
+        const auto& entry = fast_instruction_cache[FastInstructionCacheIndex(pc)];
+        if (entry.generation != fast_instruction_cache_generation || entry.pc != pc) {
+            return false;
+        }
+        offset = entry.offset;
+        return true;
+    }
+
+    void StoreFastInstructionCache(u32 pc, std::size_t offset) {
+        auto& entry = fast_instruction_cache[FastInstructionCacheIndex(pc)];
+        entry = {offset, pc, fast_instruction_cache_generation};
+    }
+
+    void ClearFastInstructionCache() {
+        if (++fast_instruction_cache_generation == 0) {
+            for (auto& entry : fast_instruction_cache) {
+                entry.generation = 0;
+            }
+            fast_instruction_cache_generation = 1;
+        }
+    }
+
+    // Raw view of the active process page table. A non-null page entry is guaranteed to be plain
+    // RAM, while MMIO and rasterizer-cached pages remain on MemorySystem's slow path.
+    u8* const* fastmem_page_table = nullptr;
+
+private:
+    static constexpr std::size_t FastInstructionCacheIndex(u32 pc) {
+        constexpr u32 hash_multiplier = 0x9E3779B1U;
+        return ((pc >> 1) * hash_multiplier) >> (32 - FAST_INSTRUCTION_CACHE_BITS);
+    }
+
+    std::array<FastInstructionCacheEntry, FAST_INSTRUCTION_CACHE_SIZE> fast_instruction_cache{};
+    u32 fast_instruction_cache_generation = 1;
+#endif
+
 private:
     void ResetMPCoreCP15Registers();
 

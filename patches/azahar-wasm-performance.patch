+void EnsureWindow() {
+    if (telemetry.initialized)
+        return;
+
+    const auto now = Clock::now();
+    telemetry.initialized = true;
+    telemetry.window_start = now;
+}
+
+unsigned ToUnsigned(uint64_t value) {
+    return static_cast<unsigned>(std::min<uint64_t>(
+        value, std::numeric_limits<unsigned>::max()));
+}
+
+unsigned AverageMicroseconds(uint64_t total, uint64_t count) {
+    return count == 0 ? 0 : ToUnsigned(total / count);
+}
+
+unsigned FrameTimePercentileMs(unsigned percentile) {
+    static constexpr std::array<unsigned, 7> bucket_limits_ms = {
+        8, 16, 20, 25, 33, 50, 100,
+    };
+    if (telemetry.frame_intervals == 0)
+        return 0;
+
+    const uint64_t target = std::max<uint64_t>(
+        1, (telemetry.frame_intervals * percentile + 99) / 100);
+    uint64_t observed = 0;
+    for (std::size_t bucket = 0; bucket < telemetry.frame_time_buckets.size(); ++bucket) {
+        observed += telemetry.frame_time_buckets[bucket];
+        if (observed >= target) {
+            return bucket < bucket_limits_ms.size() ? bucket_limits_ms[bucket] : 101;
+        }
+    }
+    return 101;
+}
+
+void PublishIfReady() {
+    EnsureWindow();
+    const auto now = Clock::now();
+    const auto elapsed_ms = static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(now - telemetry.window_start)
+            .count());
+    if (elapsed_ms < 1000)
+        return;
+
+#ifdef __EMSCRIPTEN__
+    const auto core_perf = Core::System::GetInstance().GetAndResetPerfStats();
+    const std::array<double, 9> core_perf_values = {
+        core_perf.system_fps,
+        core_perf.game_fps,
+        core_perf.emulation_speed,
+        core_perf.time_vblank_interval * 1000.0,
+        core_perf.time_hle_svc * 1000.0,
+        core_perf.time_hle_ipc * 1000.0,
+        core_perf.time_gpu * 1000.0,
+        core_perf.time_swap * 1000.0,
+        core_perf.time_remaining * 1000.0,
+    };
+    const unsigned elapsed = ToUnsigned(elapsed_ms);
+    const unsigned frames = ToUnsigned(telemetry.frames);
+    const unsigned frame_avg_us =
+        AverageMicroseconds(telemetry.frame_interval_us, telemetry.frame_intervals);
+    const unsigned frame_max_us = ToUnsigned(telemetry.frame_interval_max_us);
+    const unsigned frame_p50_ms = FrameTimePercentileMs(50);
+    const unsigned frame_p95_ms = FrameTimePercentileMs(95);
+    const unsigned core_avg_us =
+        AverageMicroseconds(telemetry.core_run_us, telemetry.core_runs);
+    const unsigned core_max_us = ToUnsigned(telemetry.core_run_max_us);
+    const unsigned video_avg_us =
+        AverageMicroseconds(telemetry.video_submit_us, telemetry.video_submits);
+    const unsigned video_max_us = ToUnsigned(telemetry.video_submit_max_us);
+    const unsigned audio_frames = ToUnsigned(telemetry.audio_frames);
+    const unsigned input_polls = ToUnsigned(telemetry.input_polls);
+    // Emscripten's EM_ASM bridge exposes at most 16 positional arguments
+    // ($0 through $15). Pack the layout values so the telemetry callback
+    // cannot emit an invalid JavaScript reference such as `$16`.
+    const unsigned layout_wh = telemetry.width | (telemetry.height << 16);
+    const unsigned bottom_enabled = telemetry.bottom_screen_enabled ? 1 : 0;
+    const unsigned bottom_left_top = telemetry.bottom_left | (telemetry.bottom_top << 16);
+    const unsigned bottom_right_bottom =
+        telemetry.bottom_right | (telemetry.bottom_bottom << 16);
+
+    EM_ASM(({
+        const elapsedMs = $0;
+        const sample = {
+            at: Date.now(),
+            elapsedMs,
+            fps: elapsedMs > 0 ? ($1 * 1000) / elapsedMs : 0,
+            frameTimeMs: $2 / 1000,
+            frameTimeMaxMs: $3 / 1000,
+            frameTimeP50Ms: $4,
+            frameTimeP95Ms: $5,
+            coreRunMs: $6 / 1000,
+            coreRunMaxMs: $7 / 1000,
+            videoSubmitMs: $8 / 1000,
+            videoSubmitMaxMs: $9 / 1000,
+            audioFrames: $10,
+            inputPolls: $11,
+            layout: {
+                width: $12 & 0xffff,
+                height: $12 >>> 16,
+                bottomScreenEnabled: !!$14,
+                bottom: {
+                    left: $13 & 0xffff,
+                    top: $13 >>> 16,
+                    right: $15 & 0xffff,
+                    bottom: $15 >>> 16
+                }
+            }
+        };
+        globalThis.__AZAHAR_PERF__ = sample;
+    }), elapsed, frames, frame_avg_us, frame_max_us, frame_p50_ms, frame_p95_ms,
+       core_avg_us, core_max_us, video_avg_us, video_max_us, audio_frames,
+       input_polls, layout_wh, bottom_left_top, bottom_enabled, bottom_right_bottom);
+
+    EM_ASM(({
+        const base = $0 >>> 3;
+        const sample = globalThis.__AZAHAR_PERF__;
+        sample.systemFps = HEAPF64[base];
+        sample.gameFps = HEAPF64[base + 1];
+        sample.emulationSpeed = HEAPF64[base + 2];
+        sample.vblankMs = HEAPF64[base + 3];
+        sample.hleSvcMs = HEAPF64[base + 4];
+        sample.hleIpcMs = HEAPF64[base + 5];
+        sample.gpuMs = HEAPF64[base + 6];
+        sample.swapMs = HEAPF64[base + 7];
+        sample.remainingMs = HEAPF64[base + 8];
+        if (typeof globalThis.__reportBrowserLog === "function")
+            globalThis.__reportBrowserLog("azahar-perf", sample);
+    }), core_perf_values.data());
+#endif
+
+    telemetry.window_start = now;
+    telemetry.frames = 0;
+    telemetry.frame_interval_us = 0;
+    telemetry.frame_intervals = 0;
+    telemetry.frame_interval_max_us = 0;
+    telemetry.frame_time_buckets.fill(0);
+    telemetry.core_runs = 0;
+    telemetry.core_run_us = 0;
+    telemetry.core_run_max_us = 0;
+    telemetry.video_submits = 0;
+    telemetry.video_submit_us = 0;
+    telemetry.video_submit_max_us = 0;
+    telemetry.audio_frames = 0;
+    telemetry.input_polls = 0;
+}
+
+} // namespace
+
+void BeginRetroRun() {
+    EnsureWindow();
+    telemetry.run_start = Clock::now();
+    telemetry.run_active = true;
+}
+
+void EndRetroRun() {
+    EnsureWindow();
+    if (telemetry.run_active) {
+        const auto duration_us = static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - telemetry.run_start)
+                .count());
+        telemetry.core_runs++;
+        telemetry.core_run_us += duration_us;
+        telemetry.core_run_max_us = std::max(telemetry.core_run_max_us, duration_us);
+        telemetry.run_active = false;
+    }
+    PublishIfReady();
+}
+
+void OnVideoFrame(unsigned frame_width, unsigned frame_height, bool bottom_enabled,
+                  unsigned bottom_left, unsigned bottom_top, unsigned bottom_right,
+                  unsigned bottom_bottom) {
+    EnsureWindow();
+    const auto now = Clock::now();
+    if (telemetry.have_last_video) {
+        const auto interval_us = static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(now - telemetry.last_video)
+                .count());
+        telemetry.frame_interval_us += interval_us;
+        telemetry.frame_interval_max_us =
+            std::max(telemetry.frame_interval_max_us, interval_us);
+        telemetry.frame_intervals++;
+        const std::size_t bucket = interval_us <= 8000
+                                       ? 0
+                                       : interval_us <= 16000
+                                             ? 1
+                                             : interval_us <= 20000
+                                                   ? 2
+                                                   : interval_us <= 25000
+                                                         ? 3
+                                                         : interval_us <= 33000
+                                                               ? 4
+                                                               : interval_us <= 50000
+                                                                     ? 5
+                                                                     : interval_us <= 100000 ? 6 : 7;
+        telemetry.frame_time_buckets[bucket]++;
+    }
+    telemetry.have_last_video = true;
+    telemetry.last_video = now;
+    telemetry.frames++;
+    telemetry.width = frame_width;
+    telemetry.height = frame_height;
+    telemetry.bottom_screen_enabled = bottom_enabled;
+    telemetry.bottom_left = bottom_left;
+    telemetry.bottom_top = bottom_top;
+    telemetry.bottom_right = bottom_right;
+    telemetry.bottom_bottom = bottom_bottom;
+}
+
+void OnVideoSubmit(std::uint64_t duration_us) {
+    EnsureWindow();
+    telemetry.video_submits++;
+    telemetry.video_submit_us += duration_us;
+    telemetry.video_submit_max_us = std::max(telemetry.video_submit_max_us, duration_us);
+}
+
+void OnAudioFrames(size_t frames) {
+    EnsureWindow();
+    telemetry.audio_frames += frames;
+}
+
+void OnInputPoll() {
+    EnsureWindow();
+    telemetry.input_polls++;
+}
+

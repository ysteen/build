--- /dev/null
+++ b/src/NDSCart_SaveDetection.h
@@ -0,0 +1,93 @@
+#ifndef NDSCART_SAVEDETECTION_H
+#define NDSCART_SAVEDETECTION_H
+
+#include <cstring>
+#include "types.h"
+#include "ROMList.h"
+
+namespace NDSCart
+{
+
+enum class SaveDetectionSource { Database, Regional, Homebrew, Override, Fallback };
+
+struct SaveDetection
+{
+    ROMListEntry Params;
+    SaveDetectionSource Source;
+};
+
+inline u32 SaveMemorySize(u32 type)
+{
+    static const u32 sizes[] = {
+        0, 512, 8192, 65536, 128*1024, 256*1024, 512*1024, 1024*1024,
+        8192*1024, 16384*1024, 65536*1024
+    };
+    return type <= 10 ? sizes[type] : 0;
+}
+
+inline const char* SaveMemoryTypeName(u32 type)
+{
+    static const char* names[] = {
+        "None", "EEPROM 512 B", "EEPROM 8 KiB", "EEPROM 64 KiB", "EEPROM 128 KiB",
+        "Flash 256 KiB", "Flash 512 KiB", "Flash 1 MiB", "NAND 8 MiB",
+        "NAND 16 MiB", "NAND 64 MiB"
+    };
+    return type <= 10 ? names[type] : "Unknown";
+}
+
+inline int ParseSaveMemoryOverride(const char* option)
+{
+    if (option)
+        for (u32 type = 0; type <= 10; type++)
+            if (std::strcmp(option, SaveMemoryTypeName(type)) == 0)
+                return static_cast<int>(type);
+    return -1;
+}
+
+inline SaveDetection DetectSaveMemory(u32 gamecode, u32 romsize, bool homebrew, int overrideType)
+{
+    SaveDetection result = {{gamecode, romsize, 2}, SaveDetectionSource::Fallback};
+    if (homebrew)
+        return {{gamecode, romsize, 0}, SaveDetectionSource::Homebrew};
+    if (overrideType >= 0 && overrideType <= 10)
+        return {{gamecode, romsize, static_cast<u32>(overrideType)}, SaveDetectionSource::Override};
+
+    const u32 count = sizeof(ROMList) / sizeof(ROMList[0]);
+    u32 low = 0, high = count;
+    while (low < high)
+    {
+        const u32 mid = low + (high - low) / 2;
+        if (ROMList[mid].GameCode < gamecode)
+            low = mid + 1;
+        else
+            high = mid;
+    }
+    if (low < count && ROMList[low].GameCode == gamecode)
+        return {ROMList[low], SaveDetectionSource::Database};
+
+    for (u32 i = 0; i < 4; i++)
+    {
+        const u8 c = gamecode >> (8 * i);
+        if (!((c >= 'A' && c <= 'Z') || (i < 3 && c >= '0' && c <= '9')))
+            return result;
+    }
+
+    // Translation patches often change only the region letter; all known variants must agree.
+    int regionalType = -1;
+    for (const ROMListEntry& entry : ROMList)
+    {
+        if ((entry.GameCode & 0xFFFFFF) != (gamecode & 0xFFFFFF))
+            continue;
+        if (entry.SaveMemType > 10 ||
+            (regionalType >= 0 && static_cast<u32>(regionalType) != entry.SaveMemType))
+            return result;
+        regionalType = entry.SaveMemType;
+    }
+    if (regionalType >= 0)
+        return {{gamecode, romsize, static_cast<u32>(regionalType)}, SaveDetectionSource::Regional};
+    return result;
+}
+
+}
+
+#endif

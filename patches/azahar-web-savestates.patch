-std::vector<u8> DecompressDataZSTD(std::span<const u8> compressed) {
-    const std::size_t decompressed_size = GetDecompressedSize(compressed);
+std::vector<u8> DecompressDataZSTD(std::span<const u8> compressed, std::size_t max_size) {
+    // Zstandard sizes are 64-bit even on wasm32. Do not truncate before checking
+    // the caller's allocation limit (including the error/unknown sentinels).
+    const u64 decompressed_size = GetDecompressedSize(compressed);
 
     if (decompressed_size == ZSTD_CONTENTSIZE_UNKNOWN) {
         LOG_ERROR(Common, "ZSTD decompressed size could not be determined.");
         return {};
     }
-    if (decompressed_size == ZSTD_CONTENTSIZE_ERROR || ZSTD_isError(decompressed_size)) {
+    if (decompressed_size == ZSTD_CONTENTSIZE_ERROR) {
